{
  "cleanUrls": true,
  "functions": {
    "api/evaluate.js": {
      "maxDuration": 60
    },
    "api/drill.js": {
      "maxDuration": 20
    },
    "api/assist.js": {
      "maxDuration": 20
    },
    "api/stats.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/reading",
      "destination": "/drill"
    },
    {
      "source": "/reading/core",
      "destination": "/core"
    }
  ]
}
